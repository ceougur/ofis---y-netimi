{
  "name": "destekofis",
  "version": "1.3.0",
  "private": true,
  "description": "DestekOfis — hukuk ofisleri için merkezi dosya takip sunucusu (server/client)",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/server.mjs",
    "start:local": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/server.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.mjs\"",
    "test:e2e": "node --disable-warning=ExperimentalWarning test/e2e/run.mjs",
    "check": "node tools/check-syntax.mjs",
    "backup": "node --disable-warning=ExperimentalWarning tools/backup.mjs",
    "package": "node tools/package.mjs",
    "start:service": "node --disable-warning=ExperimentalWarning server/supervisor.mjs",
    "build:windows": "node tools/build-windows.mjs",
    "release": "node tools/release.mjs"
  },
  "devDependencies": {
    "innosetup": "6.4.1",
    "marked": "^16.4.2",
    "playwright": "1.56.0"
  }
}
