{
  "name": "destekofis",
  "version": "2.0.13",
  "private": true,
  "description": "DestekOfis — ofisler için merkezi kayıt takip ve yönetim sunucusu (server/client); yüklenen veriye göre sektöre uyum sağlar",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/server.mjs",
    "start:local": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/server.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.mjs\"",
    "test:e2e": "node --disable-warning=ExperimentalWarning test/e2e/run.mjs",
    "test:senaryo": "node --disable-warning=ExperimentalWarning test/e2e/senaryo-tablodan-aktar.mjs",
    "test:senaryo-rapor": "node --disable-warning=ExperimentalWarning test/e2e/senaryo-raporlar.mjs",
    "test:senaryo-taslak": "node --disable-warning=ExperimentalWarning test/e2e/senaryo-taslak.mjs",
    "test:senaryo-210": "node --disable-warning=ExperimentalWarning test/e2e/senaryo-210.mjs",
    "test:senaryo-211": "node --disable-warning=ExperimentalWarning test/e2e/senaryo-211.mjs",
    "test:senaryo-212": "node --disable-warning=ExperimentalWarning test/e2e/senaryo-212.mjs",
    "test:senaryo-213": "node --disable-warning=ExperimentalWarning test/e2e/senaryo-213.mjs",
    "test:senaryo-214": "node --disable-warning=ExperimentalWarning test/e2e/senaryo-214.mjs",
    "test:senaryo-whatsapp": "node --disable-warning=ExperimentalWarning test/e2e/senaryo-whatsapp.mjs",
    "test:mutabakat": "node --disable-warning=ExperimentalWarning test/mutabakat/kos.mjs",
    "mutabakat": "node --disable-warning=ExperimentalWarning tools/mutabakat.mjs",
    "check": "node tools/check-syntax.mjs",
    "backup": "node --disable-warning=ExperimentalWarning tools/backup.mjs",
    "package": "node tools/package.mjs",
    "start:service": "node --disable-warning=ExperimentalWarning server/supervisor.mjs",
    "build:windows": "node tools/build-windows.mjs",
    "release": "node tools/release.mjs"
  },
  "devDependencies": {
    "innosetup": "6.4.1",
    "marked": "^16.4.2",
    "playwright": "1.56.0"
  }
}
